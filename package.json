{
  "name": "incontrol-agents",
  "version": "0.1.0",
  "description": "Always-on Side Panel & Cross-Device Mission Control for AI Coding Agents (Claude Code, Antigravity, Cursor, Codex, Aider & Custom Agents)",
  "license": "FSL-1.1-MIT",
  "author": "Ioannis Zempekakis <izempekakis@gmail.com> (https://x.com/ioanniszempe)",
  "homepage": "https://github.com/IoannisZempe/InControl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IoannisZempe/InControl.git"
  },
  "bugs": {
    "url": "https://github.com/IoannisZempe/InControl/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/",
    "src/",
    "public/",
    "railway-collector/",
    "scripts/setup-railway.sh",
    "macos/InControlPanel.swift",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./src/sdk/index.js",
  "exports": {
    ".": "./src/sdk/index.js",
    "./sdk": "./src/sdk/index.js"
  },
  "bin": {
    "theone": "./bin/incontrol.js",
    "incontrol": "./bin/incontrol.js",
    "incontrol-agents": "./bin/incontrol.js"
  },
  "scripts": {
    "start": "node ./bin/incontrol.js start",
    "panel": "node ./bin/incontrol.js panel",
    "service": "node ./bin/incontrol.js service",
    "build:macos": "swiftc macos/InControlPanel.swift -o macos/incontrol-panel -framework Cocoa -framework WebKit",
    "mcp": "node ./bin/incontrol.js mcp",
    "pack:check": "npm pack --dry-run",
    "test": "node --test test/*.test.js",
    "test:unit": "node --test test/unit-flows.test.js",
    "test:flows": "node --test test/integration-flows.test.js"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "antigravity",
    "cursor",
    "mcp",
    "side-panel",
    "mission-control",
    "developer-tools",
    "macos"
  ],
  "dependencies": {
    "hap-nodejs": "^0.14.3",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  }
}
